{
  "openapi": "3.1.0",
  "info": {
    "title": "A-Pidoc local example",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://127.0.0.1:3001" }
  ],
  "paths": {
    "/orders": {
      "post": {
        "summary": "Create an order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount"],
                "properties": {
                  "amount": { "type": "number", "example": 12 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Order accepted" }
        }
      }
    }
  }
}
