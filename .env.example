# Copy this file to .env and replace the placeholder locally.
# .env is ignored by Git. Never commit a real API key.
A_PIDOC_REASONER=pi
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
A_PIDOC_PI_FALLBACK=none
A_PIDOC_PI_TIMEOUT_MS=30000
A_PIDOC_PI_MAX_OUTPUT_TOKENS=2048
A_PIDOC_PI_MAX_PROMPT_BYTES=32768
# Optional on loopback; required for non-loopback binding. Generate your own value (16+ characters).
A_PIDOC_API_TOKEN=
A_PIDOC_ALLOWED_PORTS=80,443
