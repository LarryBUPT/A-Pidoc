{
  "name": "a-pidoc",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "description": "A Pi-powered API debugging agent with deterministic safety and evaluation gates.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "npm run build --silent && node dist/src/cli.js all",
    "demo:harness": "npm run build --silent && node scripts/harness-demo.mjs",
    "mcp": "npm run build --silent && node dist/src/mcp/server.js",
    "demo:mcp": "npm run build --silent && node scripts/mcp-demo.mjs",
    "serve": "npm run build --silent && node dist/src/server.js",
    "serve:pi": "npm run build --silent && node --env-file=.env dist/src/server.js",
    "test:unit": "node --test --test-concurrency=1 dist/test/*.test.js",
    "test:pi": "node --test dist/test/pi-reasoner.test.js",
    "test:pi:live": "npm run build --silent && node --env-file=.env scripts/pi-live-smoke.mjs",
    "test": "npm run build --silent && npm run test:unit",
    "eval:pi:stability": "node scripts/pi-tier-a.mjs",
    "eval:harness": "npm run build --silent && node scripts/harness-contract-eval.mjs",
    "eval:agentic": "npm run build --silent && node scripts/agentic-eval.mjs",
    "eval:agentic:live": "npm run build --silent && node --env-file=.env scripts/agentic-live.mjs",
    "eval:business": "npm run build --silent && node dist/src/cli.js eval",
    "eval:repository": "npm run build --silent && node scripts/repository-eval.mjs",
    "eval:contract": "npm run build --silent && node scripts/contract-eval.mjs",
    "eval:collaboration": "npm run build --silent && node scripts/collaboration-eval.mjs",
    "demo:team": "npm run build --silent && node dist/src/cli.js collaboration-demo",
    "repo:plan": "npm run build --silent && node dist/src/cli.js repo-plan",
    "eval:tier-a": "npm run test:unit && npm run eval:pi:stability",
    "check": "npm run build --silent && npm run test:unit",
    "demo:reliability": "npm run build --silent && node scripts/reliability-demo.mjs",
    "eval:reliability": "npm run build --silent && node scripts/reliability-eval.mjs",
    "eval:reliability:live": "npm run build --silent && node --env-file=.env scripts/reliability-live.mjs",
    "eval:performance": "npm run build --silent && node scripts/performance-eval.mjs",
    "benchmark:probe": "npm run build --silent && node dist/src/benchmark/cli.js probe",
    "benchmark:receipt": "npm run build --silent && node dist/src/benchmark/cli.js receipt",
    "eval:external": "npm run build --silent && node dist/src/benchmark/cli.js eval",
    "test:audit": "node --test --test-concurrency=1 test/audit-workflow.test.mjs",
    "audit:prepare": "node scripts/audit-workflow.mjs prepare",
    "audit:advance": "node scripts/audit-workflow.mjs advance",
    "audit:status": "node scripts/audit-workflow.mjs status",
    "audit:stop": "node scripts/audit-workflow.mjs stop",
    "audit:archive": "node scripts/audit-workflow.mjs archive",
    "audit:summary": "node scripts/review-summary.mjs",
    "audit:validate": "node scripts/validate-review-summary.mjs",
    "review:metrics": "node scripts/review-summary.mjs --metrics"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.3.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  }
}
